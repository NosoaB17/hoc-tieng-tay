---
const { title = 'Học tiếng Tày', description = 'Tự học tiếng Tày qua tư liệu có nguồn, được xác minh và tôn trọng người nói.' } = Astro.props;
const base = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`;
const links = [
  { href: base, label: 'Trang chủ' },
  { href: `${base}lo-trinh/`, label: 'Lộ trình' },
  { href: `${base}tu-lieu/`, label: 'Tư liệu' },
];
const currentPath = Astro.url.pathname;
---
<!doctype html>
<html lang="vi">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#f5f1e7" />
    <title>{title}</title>
  </head>
  <body>
    <a class="skip-link" href="#main">Bỏ qua điều hướng</a>
    <header class="site-header">
      <a class="wordmark" href={base} aria-label="Học tiếng Tày — trang chủ">
        <span class="wordmark-mark" aria-hidden="true">T</span>
        <span>Học tiếng Tày</span>
      </a>
      <nav aria-label="Điều hướng chính">
        {links.map((link) => (
          <a href={link.href} aria-current={currentPath === link.href ? 'page' : undefined}>{link.label}</a>
        ))}
      </nav>
    </header>
    <main id="main"><slot /></main>
    <footer class="site-footer">
      <p>Học tiếng Tày, bắt đầu từ sự lắng nghe và tôn trọng.</p>
      <a href={`${base}tu-lieu/`}>Tìm hiểu về nguồn tư liệu</a>
    </footer>
  </body>
</html>

<style is:global>
  :root {
    color-scheme: light;
    --paper: #f5f1e7;
    --paper-deep: #e9e1d1;
    --ink: #252a22;
    --ink-soft: #565b50;
    --green: #34513e;
    --green-deep: #263e30;
    --gold: #a2672e;
    --line: #d8d0c0;
    --serif: "Iowan Old Style", "Palatino Linotype", "Book Antiqua", Georgia, serif;
    --sans: "Avenir Next", Avenir, "Segoe UI", sans-serif;
    font-family: var(--sans);
    color: var(--ink);
    background: var(--paper);
    font-synthesis: none;
    text-rendering: optimizeLegibility;
    -webkit-font-smoothing: antialiased;
    -moz-osx-font-smoothing: grayscale;
  }
  *, *::before, *::after { box-sizing: border-box; }
  body { margin: 0; min-width: 320px; }
  a { color: inherit; text-underline-offset: 0.22em; text-decoration-thickness: 1px; }
  a:hover { color: var(--green); }
  a:focus-visible { outline: 3px solid var(--gold); outline-offset: 4px; border-radius: 2px; }
  ::selection { color: var(--paper); background: var(--green); }
  :focus-visible { caret-color: var(--gold); }
  .skip-link {
    position: absolute; top: 0.75rem; left: 0.75rem; z-index: 2;
    padding: 0.65rem 0.85rem; color: var(--paper); background: var(--green);
    transform: translateY(-160%);
  }
  .skip-link:focus { transform: translateY(0); }
  .site-header {
    min-height: 5.25rem; max-width: 1240px; margin: 0 auto; padding: 0 3rem;
    display: flex; align-items: center; justify-content: space-between; gap: 2rem;
    border-bottom: 1px solid var(--line);
  }
  .wordmark { display: inline-flex; align-items: center; gap: 0.7rem; text-decoration: none; font-weight: 650; letter-spacing: -0.025em; }
  .wordmark-mark {
    width: 2rem; height: 2rem; display: grid; place-items: center; border: 1px solid var(--green);
    color: var(--green); font-family: var(--serif); font-size: 1.2rem; font-style: italic;
  }
  nav { display: flex; align-items: center; gap: clamp(1rem, 3vw, 2.75rem); }
  nav a { padding: 0.65rem 0; text-decoration: none; color: var(--ink-soft); font-size: 0.93rem; }
  nav a[aria-current="page"] { color: var(--ink); box-shadow: inset 0 -2px var(--green); }
  .site-footer {
    max-width: 1240px; margin: 0 auto; padding: 1.4rem 3rem 2rem; border-top: 1px solid var(--line);
    display: flex; justify-content: space-between; align-items: baseline; gap: 1rem 2rem;
    color: var(--ink-soft); font-size: 0.87rem;
  }
  .site-footer p { margin: 0; }
  .site-footer a { color: var(--green-deep); }
  @media (max-width: 600px) {
    .site-header { min-height: auto; padding: 1rem 1.15rem 0.8rem; align-items: flex-start; flex-direction: column; gap: 0.7rem; }
    nav { width: 100%; justify-content: space-between; gap: 0.5rem; }
    nav a { font-size: 0.88rem; }
    .site-footer { padding: 1.25rem 1.15rem 1.75rem; flex-direction: column; align-items: flex-start; }
  }
</style>
