---
import SiteLayout from '../layouts/SiteLayout.astro';
const base = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`;
---
<SiteLayout title="Lộ trình học — Học tiếng Tày">
  <article class="page-shell">
    <header class="page-heading">
      <h1>Lộ trình học</h1>
      <p>Đi từ làm quen đến tự tin hơn, từng bước một. Bạn có thể quay lại hoặc bỏ qua phần đã biết.</p>
    </header>
    <section class="empty-state" aria-live="polite" aria-atomic="true">
      <div class="empty-mark" aria-hidden="true"><span></span><span></span><span></span></div>
      <div id="catalog" class="catalog" role="status">
        <p class="state-label">Loading lessons</p>
        <h2>Checking for published lessons</h2>
      </div>
    </section>
    <section class="framework" aria-labelledby="framework-title">
      <h2 id="framework-title">Khung học dự kiến</h2>
      <p class="framework-intro">Các bước dưới đây là định hướng, chưa phải bài học đang mở.</p>
      <ol>
        <li><span>01</span><div><h3>Làm quen với âm thanh</h3><p>Nghe bản thu đã được phép sử dụng, không đoán thay khi chưa có dữ liệu.</p></div></li>
        <li><span>02</span><div><h3>Hiểu lời trong ngữ cảnh</h3><p>Giải nghĩa theo tình huống thực tế, có người nói địa phương duyệt.</p></div></li>
        <li><span>03</span><div><h3>Thử đáp và ôn lại</h3><p>Tập phản hồi theo nhịp riêng, lưu tiến độ trên thiết bị khi tính năng sẵn sàng.</p></div></li>
      </ol>
    </section>
  </article>
</SiteLayout>

<script>
  import { loadCatalog } from '../lib/catalog';

  const catalog = document.querySelector<HTMLElement>('#catalog');
  const catalogUrl = import.meta.env.PUBLIC_SUPABASE_URL ?? '';
  const publishableKey = import.meta.env.PUBLIC_SUPABASE_PUBLISHABLE_KEY ?? '';

  function text(tag: string, value: string, className?: string) {
    const element = document.createElement(tag);
    element.textContent = value;
    if (className) element.className = className;
    return element;
  }

  async function renderCatalog() {
    if (!catalog) return;
    catalog.replaceChildren(text('p', 'Loading lessons', 'state-label'), text('h2', 'Checking for published lessons'));
    const result = await loadCatalog({ url: catalogUrl, publishableKey });
    catalog.replaceChildren();

    if (result.state === 'unavailable') {
      catalog.append(text('p', 'Catalog unavailable', 'state-label'), text('h2', 'Lessons could not be loaded.'), text('p', 'Please check your connection and try again.'));
      const retry = text('button', 'Try again');
      retry.type = 'button';
      retry.addEventListener('click', renderCatalog);
      catalog.append(retry);
      return;
    }

    if (result.state === 'empty') {
      catalog.append(
        text('p', 'No published lessons yet', 'state-label'),
        text('h2', 'There are no approved lessons to show.'),
        text('p', 'Lessons will appear here after their sources, local review, and usage rights are confirmed.', 'state-copy'),
      );
    } else {
      catalog.append(text('p', 'Published lessons', 'state-label'), text('h2', 'Available lessons'));
      const list = document.createElement('ul');
      list.className = 'lesson-list';
      for (const lesson of result.lessons) {
        const item = document.createElement('li');
        item.append(text('h3', lesson.title), text('p', lesson.summary));
        item.append(text('p', `Region: ${lesson.region}`, 'lesson-region'));
        list.append(item);
      }
      catalog.append(list);
    }
    const sourceLink = document.createElement('a');
    sourceLink.href = `${import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`}tu-lieu/`;
    sourceLink.append('How we choose learning materials ', text('span', '→'));
    sourceLink.lastElementChild?.setAttribute('aria-hidden', 'true');
    catalog.append(sourceLink);
  }

  void renderCatalog();
</script>

<style>
  .page-shell { max-width: 1040px; margin: 0 auto; padding: 4.5rem 3rem 5rem; }
  .page-heading { max-width: 680px; padding-bottom: 2.8rem; }
  h1, h2, h3, p { margin-top: 0; }
  h1 { margin-bottom: 0.8rem; font: 500 clamp(3rem, 6vw, 5rem)/1.02 var(--serif); letter-spacing: -0.035em; }
  .page-heading p { max-width: 56ch; margin: 0; color: var(--ink-soft); font-size: 1.05rem; line-height: 1.7; }
  .empty-state { display: grid; grid-template-columns: 150px minmax(0, 1fr); gap: 2rem; align-items: start; padding: 2.5rem 0 2.8rem; border-top: 1px solid var(--line); border-bottom: 1px solid var(--line); }
  .empty-mark { width: 116px; height: 116px; display: grid; place-items: center; position: relative; border: 1px solid var(--line); border-radius: 50%; }
  .empty-mark span { position: absolute; width: 30px; height: 30px; border: 1px solid var(--green); border-radius: 50%; }
  .empty-mark span:nth-child(2) { transform: translate(15px, -15px); border-color: var(--gold); }
  .empty-mark span:nth-child(3) { transform: translate(-15px, 15px); border-color: var(--paper-deep); }
  .state-label { margin-bottom: 0.55rem; color: var(--green); font-size: 0.85rem; font-weight: 650; }
  h2 { margin-bottom: 0.65rem; font: 500 clamp(1.8rem, 3vw, 2.5rem)/1.12 var(--serif); letter-spacing: -0.02em; }
  .state-copy { max-width: 65ch; color: var(--ink-soft); line-height: 1.75; }
  .empty-state a { color: var(--green-deep); font-weight: 600; }
  .catalog button { padding: 0.55rem 0.8rem; border: 1px solid var(--green); border-radius: 0.25rem; background: transparent; color: var(--green-deep); font: inherit; font-weight: 600; cursor: pointer; }
  .catalog button:hover { background: var(--green); color: var(--paper); }
  .catalog button:focus-visible { outline: 2px solid var(--gold); outline-offset: 3px; }
  .lesson-list { list-style: none; margin: 1.2rem 0; padding: 0; }
  .lesson-list li { padding: 1rem 0; border-top: 1px solid var(--line); }
  .lesson-list h3 { margin-bottom: 0.35rem; }
  .lesson-list p { margin: 0.25rem 0; color: var(--ink-soft); line-height: 1.65; }
  .lesson-list .lesson-region { font-size: 0.9rem; }
  .framework { padding-top: 3.7rem; }
  .framework h2 { font-size: 2rem; }
  .framework-intro { margin-bottom: 1.4rem; color: var(--ink-soft); }
  .framework ol { list-style: none; margin: 0; padding: 0; }
  .framework li { display: grid; grid-template-columns: 3rem 1fr; gap: 1rem; padding: 1.15rem 0; border-top: 1px solid var(--line); }
  .framework li > span { color: var(--gold); font-family: var(--serif); font-style: italic; }
  h3 { margin-bottom: 0.35rem; font: 500 1.25rem var(--serif); }
  .framework li p { max-width: 62ch; margin: 0; color: var(--ink-soft); line-height: 1.65; }
  @media (max-width: 600px) {
    .page-shell { padding: 3.3rem 1.2rem 3.8rem; }
    .empty-state { grid-template-columns: 1fr; gap: 1.5rem; padding: 1.8rem 0 2rem; }
    .empty-mark { width: 84px; height: 84px; }
  }
</style>
